{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "Enrich-Incident-IPReputation",
    "description": "When Microsoft Sentinel creates an incident, look up every IP entity in VirusTotal, write one summary comment on the incident and tag it 'enriched' or 'malicious-ip'. Read-only: it never closes an incident or changes its status.",
    "prerequisites": "A Key Vault secret holding a VirusTotal API key. After deployment, grant the playbook's managed identity the Microsoft Sentinel Responder role on the workspace resource group and 'Get' permission on secrets in the Key Vault.",
    "author": {
      "name": "Archi Rose Mani"
    }
  },
  "parameters": {
    "PlaybookName": {
      "defaultValue": "Enrich-Incident-IPReputation",
      "type": "string"
    },
    "KeyVaultName": {
      "type": "string",
      "metadata": {
        "description": "Key Vault that holds the VirusTotal API key"
      }
    },
    "SecretName": {
      "defaultValue": "virustotal-api-key",
      "type": "string"
    },
    "MaliciousThreshold": {
      "defaultValue": 3,
      "type": "int",
      "metadata": {
        "description": "Malicious engine votes at which an IP counts as flagged"
      }
    }
  },
  "variables": {
    "SentinelConnectionName": "[concat('azuresentinel-', parameters('PlaybookName'))]",
    "KeyVaultConnectionName": "[concat('keyvault-', parameters('PlaybookName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('SentinelConnectionName')]",
      "location": "[resourceGroup().location]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('SentinelConnectionName')]",
        "customParameterValues": {},
        "parameterValueType": "Alternative",
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]"
        }
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('KeyVaultConnectionName')]",
      "location": "[resourceGroup().location]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('KeyVaultConnectionName')]",
        "parameterValueType": "Alternative",
        "alternativeParameterValues": {
          "vaultName": "[parameters('KeyVaultName')]"
        },
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/keyvault')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2017-07-01",
      "name": "[parameters('PlaybookName')]",
      "location": "[resourceGroup().location]",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('SentinelConnectionName'))]",
        "[resourceId('Microsoft.Web/connections', variables('KeyVaultConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            },
            "MaliciousThreshold": {
              "defaultValue": 3,
              "type": "Int"
            },
            "SecretName": {
              "defaultValue": "virustotal-api-key",
              "type": "String"
            }
          },
          "triggers": {
            "Microsoft_Sentinel_incident": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "path": "/incident-creation"
              }
            }
          },
          "actions": {
            "Initialize_comment_rows": {
              "runAfter": {},
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "CommentRows",
                    "type": "string",
                    "value": ""
                  }
                ]
              }
            },
            "Initialize_flagged_count": {
              "runAfter": {
                "Initialize_comment_rows": [
                  "Succeeded"
                ]
              },
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "FlaggedCount",
                    "type": "integer",
                    "value": 0
                  }
                ]
              }
            },
            "Get_API_key_from_Key_Vault": {
              "runAfter": {
                "Initialize_flagged_count": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['keyvault']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/secrets/@{encodeURIComponent(parameters('SecretName'))}/value"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "outputs"
                  ]
                }
              }
            },
            "Entities_-_Get_IPs": {
              "runAfter": {
                "Get_API_key_from_Key_Vault": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/entities/ip"
              }
            },
            "For_each_IP": {
              "foreach": "@body('Entities_-_Get_IPs')?['IPs']",
              "runAfter": {
                "Entities_-_Get_IPs": [
                  "Succeeded"
                ]
              },
              "type": "Foreach",
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "actions": {
                "Check_IP_reputation": {
                  "runAfter": {},
                  "type": "Http",
                  "inputs": {
                    "method": "GET",
                    "uri": "https://www.virustotal.com/api/v3/ip_addresses/@{items('For_each_IP')?['Address']}",
                    "headers": {
                      "x-apikey": "@{body('Get_API_key_from_Key_Vault')?['value']}"
                    }
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs"
                      ]
                    }
                  }
                },
                "Malicious_votes": {
                  "runAfter": {
                    "Check_IP_reputation": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": "@coalesce(body('Check_IP_reputation')?['data']?['attributes']?['last_analysis_stats']?['malicious'], 0)"
                },
                "Add_row_to_comment": {
                  "runAfter": {
                    "Malicious_votes": [
                      "Succeeded"
                    ]
                  },
                  "type": "AppendToStringVariable",
                  "inputs": {
                    "name": "CommentRows",
                    "value": "<tr><td>@{items('For_each_IP')?['Address']}</td><td>@{outputs('Malicious_votes')}</td><td>@{body('Check_IP_reputation')?['data']?['attributes']?['country']}</td><td>@{body('Check_IP_reputation')?['data']?['attributes']?['as_owner']}</td></tr>"
                  }
                },
                "If_flagged": {
                  "runAfter": {
                    "Add_row_to_comment": [
                      "Succeeded"
                    ]
                  },
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "greaterOrEquals": [
                          "@outputs('Malicious_votes')",
                          "@parameters('MaliciousThreshold')"
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Count_flagged_IP": {
                      "runAfter": {},
                      "type": "IncrementVariable",
                      "inputs": {
                        "name": "FlaggedCount",
                        "value": 1
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  }
                }
              }
            },
            "Add_comment_to_incident": {
              "runAfter": {
                "For_each_IP": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "body": {
                  "incidentArmId": "@triggerBody()?['object']?['id']",
                  "message": "<p><b>IP reputation (VirusTotal)</b></p><table><tr><th>IP</th><th>Malicious votes</th><th>Country</th><th>Network owner</th></tr>@{variables('CommentRows')}</table><p>@{variables('FlaggedCount')} IP address(es) at or above the threshold of @{parameters('MaliciousThreshold')}. Added automatically by the enrichment playbook; the incident status was not changed.</p>"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/Incidents/Comment"
              }
            },
            "Tag_incident": {
              "runAfter": {
                "Add_comment_to_incident": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "body": {
                  "incidentArmId": "@triggerBody()?['object']?['id']",
                  "tagsToAdd": {
                    "TagsToAdd": [
                      {
                        "Tag": "@{if(greater(variables('FlaggedCount'), 0), 'malicious-ip', 'enriched')}"
                      }
                    ]
                  }
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "method": "put",
                "path": "/Incidents"
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('SentinelConnectionName'))]",
                "connectionName": "[variables('SentinelConnectionName')]",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              },
              "keyvault": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('KeyVaultConnectionName'))]",
                "connectionName": "[variables('KeyVaultConnectionName')]",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/keyvault')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              }
            }
          },
          "MaliciousThreshold": {
            "value": "[parameters('MaliciousThreshold')]"
          },
          "SecretName": {
            "value": "[parameters('SecretName')]"
          }
        }
      }
    }
  ],
  "outputs": {
    "playbookPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2017-07-01', 'full').identity.principalId]"
    }
  }
}
